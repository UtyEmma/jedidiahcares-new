{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jedidiah/cares",
    "type": "project",
    "description": "Jedidiah Cares Global Outreach for Women, Youth and Children — Laravel 13 with Inertia React.",
    "keywords": [
        "laravel",
        "inertia",
        "react",
        "charity"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.10",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "saade/fluppy": "^1.0",
        "spatie/laravel-sitemap": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently --kill-others --names=laravel,vite \"php artisan serve --host=127.0.0.1\" \"npm run dev\""
        ],
        "dev:ssr": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build",
            "npx concurrently --kill-others --names=laravel,ssr \"php artisan serve --host=127.0.0.1\" \"php artisan inertia:start-ssr\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
